# NomadHub Airflow — Environment Variables
# Copy to .env (same directory as docker-compose.yaml) and fill in your values.

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=NOMAD_PIPELINE_USER
SNOWFLAKE_PASSWORD=your-pipeline-password
SNOWFLAKE_DATABASE=NOMAD_HUB
SNOWFLAKE_WAREHOUSE=NOMAD_WH
SNOWFLAKE_ROLE=NOMAD_ADMIN

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=eu-central-1
S3_BUCKET=your-nomad-hub-bucket

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_PROJECT_DIR=/opt/airflow/nomad_hub
DBT_PROFILES_DIR=/opt/airflow/nomad_hub

# ── Notifications (optional) ──────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
