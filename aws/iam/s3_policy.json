{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::YOUR-NOMAD-HUB-BUCKET/raw/*"
    },
    {
      "Sid": "SnowflakeListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::YOUR-NOMAD-HUB-BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*"]
        }
      }
    }
  ]
}
