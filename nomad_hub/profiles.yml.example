nomad_hub:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: DBT_ROLE
      database: NOMAD_HUB
      warehouse: NOMAD_WH
      schema: STAGING         # default schema; overridden per model via dbt_project.yml
      threads: 4
      client_session_keep_alive: false
      query_tag: "dbt-dev"

    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: DBT_ROLE
      database: NOMAD_HUB
      warehouse: NOMAD_WH
      schema: STAGING
      threads: 8
      client_session_keep_alive: false
      query_tag: "dbt-prod"
