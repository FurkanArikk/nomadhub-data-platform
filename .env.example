# ==============================================================================
# NomadHub Platform - Environment Variables Template
# ==============================================================================
# Copy to .env and fill in your values (never commit .env):
# cp .env.example .env
# ==============================================================================

# -----------------
# Snowflake (key-pair auth only — see CLOUD.md; private keys live in ~/.nomadhub/keys)
# -----------------
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_KEY_DIR=~/.nomadhub/keys
# Service users the AI jobs connect as (defaults shown)
AI_SNOWFLAKE_USER=DBT_SVC
APP_SNOWFLAKE_USER=STREAMLIT_SVC

# -----------------
# Google Gemini AI
# -----------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere      # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash              # RAG answers + text-to-SQL
GEMINI_ENRICH_MODEL=gemini-3.5-flash-lite  # bulk review enrichment
GEMINI_EMBED_MODEL=gemini-embedding-001

# -----------------
# Airflow / Postgres Config
# -----------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
