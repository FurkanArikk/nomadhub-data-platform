# ==============================================================================
# NomadHub Platform - Environment Variables Template
# ==============================================================================
# Kendi değerlerinizi girip dosya adını '.env' olarak kopyalayınız:
# cp .env.example .env
# ==============================================================================

# -----------------
# Snowflake Config
# -----------------
SNOWFLAKE_ACCOUNT=xy12345.eu-central-1
SNOWFLAKE_USER=NOMAD_ADMIN
SNOWFLAKE_PASSWORD=YourStrongPasswordHere123!
SNOWFLAKE_ROLE=NOMAD_ADMIN
SNOWFLAKE_WAREHOUSE=NOMAD_WH
SNOWFLAKE_DATABASE=NOMAD_HUB
SNOWFLAKE_SCHEMA=RAW

# -----------------
# AWS S3 Config
# -----------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
AWS_DEFAULT_REGION=eu-central-1
S3_BUCKET_NAME=nomadhub-data-platform

# -----------------
# Google Gemini AI
# -----------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# -----------------
# Airflow / Postgres Config
# -----------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
